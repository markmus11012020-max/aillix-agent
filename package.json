{
  "name": "aillix-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aillix Agent — очный агент для второго этапа: процесс, карточки, HITL.",
  "main": "dist/plugin/index.js",
  "exports": {
    ".": "./dist/plugin/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/plugin/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke-kaiten.ts",
    "smoke:tinvest": "tsx scripts/smoke-tinvest.ts",
    "discover:kaiten": "tsx scripts/discover-kaiten.ts",
    "seed": "tsx scripts/seed-board.ts",
    "start": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "start:windows": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "start:linux": "bash ./start.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opencode/plugin": "^2.3.0",
    "dotenv": "^17.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
